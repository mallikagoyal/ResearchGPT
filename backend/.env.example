# --- General ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- CORS (comma-separated list is NOT supported; edit config.py list default,
# or set as JSON array string, e.g. ["http://localhost:3000"]) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# Matches the `postgres` service in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://researchgpt:researchgpt@postgres:5432/researchgpt
DATABASE_ECHO=false

# --- Auth / JWT ---
# REQUIRED: generate a strong random secret, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Vector store (ChromaDB) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=researchgpt_user_

# --- Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- LLM (OpenAI-compatible) ---
# LLM_PROVIDER can be "openai" or "compatible" (e.g. local vLLM / Ollama / Groq
# proxy that exposes an OpenAI-compatible /chat/completions endpoint).
LLM_PROVIDER=openai
LLM_API_KEY=sk-REPLACE_ME
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Chunking ---
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# --- RAG ---
RAG_TOP_K=5

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25
